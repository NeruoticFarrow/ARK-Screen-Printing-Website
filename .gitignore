node_modules/
# Google Business Profile copies: rebuilt at each deploy, never committed
# (Google allows only temporary copies of API content — site-src/sync/gbp-sync.mjs).
site-src/.cache/
ark-site-review/images/gbp/
ark-site-review/assets/img/gbp/
# Blog pages: written at each build from site-src/content/blog/ (the Ryze
# webhook commits only the article, so committed pages would always be behind).
ark-site-review/blog/
ark-site-review/sitemap-blog.xml
